  {
    "id": "comment_wrist",
    "type": "comment",
    "z": "sarcus_tab",
    "name": "═══ WRIST CONTROL (NEMA23 Stepper) ═══",
    "info": "Topic: sarcus/robot/joints/wrist\nJSON: {\"steps\":200,\"speed\":60,\"dir\":0,\"side\":0}",
    "x": 600,
    "y": 440
  },
  {
    "id": "slider_wrist_steps_left",
    "type": "ui_slider",
    "z": "sarcus_tab",
    "name": "Wrist L Steps",
    "group": "ui_group_wrist",
    "order": 1,
    "width": "6",
    "height": "1",
    "label": "L-Wrist Steps",
    "min": -1000,
    "max": 1000,
    "step": 10,
    "outs": "end",
    "topic": "wrist_left",
    "x": 600,
    "y": 500,
    "wires": [["func_wrist_left"]]
  },
  {
    "id": "slider_wrist_speed",
    "type": "ui_slider",
    "z": "sarcus_tab",
    "name": "Wrist Speed RPM",
    "group": "ui_group_wrist",
    "order": 2,
    "width": "6",
    "height": "1",
    "label": "Wrist Speed (RPM)",
    "min": 10,
    "max": 200,
    "step": 10,
    "outs": "all",
    "topic": "wrist_speed",
    "x": 600,
    "y": 540,
    "wires": [["func_wrist_speed_store"]]
  },
  {
    "id": "func_wrist_speed_store",
    "type": "function",
    "z": "sarcus_tab",
    "name": "Store wrist speed",
    "func": "flow.set('wrist_speed', msg.payload);\nreturn null;",
    "outputs": 0,
    "x": 820,
    "y": 540,
    "wires": []
  },
  {
    "id": "func_wrist_left",
    "type": "function",
    "z": "sarcus_tab",
    "name": "Build Wrist L cmd",
    "func": "var steps = msg.payload;\nvar speed = flow.get('wrist_speed') || 60;\nvar dir   = steps >= 0 ? 0 : 1;\nmsg.topic   = 'sarcus/robot/joints/wrist';\nmsg.payload = JSON.stringify({steps: Math.abs(steps), speed: speed, dir: dir, side: 0});\nreturn msg;",
    "outputs": 1,
    "x": 820,
    "y": 500,
    "wires": [["mqtt_out_cmd"]]
  },
  {
    "id": "slider_wrist_steps_right",
    "type": "ui_slider",
    "z": "sarcus_tab",
    "name": "Wrist R Steps",
    "group": "ui_group_wrist",
    "order": 3,
    "width": "6",
    "height": "1",
    "label": "R-Wrist Steps",
    "min": -1000,
    "max": 1000,
    "step": 10,
    "outs": "end",
    "topic": "wrist_right",
    "x": 600,
    "y": 600,
    "wires": [["func_wrist_right"]]
  },
  {
    "id": "func_wrist_right",
    "type": "function",
    "z": "sarcus_tab",
    "name": "Build Wrist R cmd",
    "func": "var steps = msg.payload;\nvar speed = flow.get('wrist_speed') || 60;\nvar dir   = steps >= 0 ? 0 : 1;\nmsg.topic   = 'sarcus/robot/joints/wrist';\nmsg.payload = JSON.stringify({steps: Math.abs(steps), speed: speed, dir: dir, side: 1});\nreturn msg;",
    "outputs": 1,
    "x": 820,
    "y": 600,
    "wires": [["mqtt_out_cmd"]]
  },

