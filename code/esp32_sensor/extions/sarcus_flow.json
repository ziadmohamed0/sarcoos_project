  {
    "id": "mqtt_in_debug",
    "type": "mqtt in",
    "z": "sarcus_tab",
    "name": "Debug Logs",
    "topic": "sarcus/debug/logs",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker",
    "x": 160,
    "y": 1100,
    "wires": [["func_debug_format"]]
  },
  {
    "id": "func_debug_format",
    "type": "function",
    "z": "sarcus_tab",
    "name": "Format log entry",
    "func": "var d = msg.payload;\nif (!d) return null;\n\nvar ts   = d.ts   ? new Date(d.ts).toLocaleTimeString() : new Date().toLocaleTimeString();\nvar lvl  = d.level || 'INFO';\nvar tag  = d.tag   || '?';\nvar text = d.msg   || JSON.stringify(d);\n\nvar icon = {DEBUG:'🔵', INFO:'🟢', WARN:'🟡', ERROR:'🔴'}[lvl] || '⚪';\nvar line = icon + ' [' + ts + '] [' + lvl + '] [' + tag + '] ' + text + '\\n';\n\nvar log = flow.get('debug_log') || '';\nvar lines = log.split('\\n');\nif (lines.length > 200) lines = lines.slice(-200);\nlines.push(line);\nflow.set('debug_log', lines.join('\\n'));\n\nmsg.payload = lines.join('\\n');\nreturn msg;",
    "outputs": 1,
    "x": 380,
    "y": 1100,
    "wires": [["ui_debug_text", "node_debug_raw"]]
  },
  {
    "id": "ui_debug_text",
    "type": "ui_template",
    "z": "sarcus_tab",
    "name": "Debug Console",
    "group": "ui_group_debug",
