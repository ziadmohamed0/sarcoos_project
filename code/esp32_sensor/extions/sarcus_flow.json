  {
    "id": "comment_shoulder",
    "type": "comment",
    "z": "sarcus_tab",
    "name": "═══ SHOULDER CONTROL ═══",
    "info": "DC Motor + Feetech 95kg Servo\nTopic: sarcus/robot/joints/shoulder\nJSON: {\"dc_angle\":45,\"servo\":90,\"side\":0}",
    "x": 600,
    "y": 40
  },
  {
    "id": "slider_sh_dc_left",
    "type": "ui_slider",
    "z": "sarcus_tab",
    "name": "Shoulder L — DC",
    "group": "ui_group_shoulder",
    "order": 1,
    "width": "6",
    "height": "1",
    "label": "L-Shoulder DC (°)",
    "tooltip": "-180 to 180",
    "min": -180,
    "max": 180,
    "step": 1,
    "outs": "all",
    "topic": "sh_dc_left",
    "x": 600,
    "y": 100,
    "wires": [["func_shoulder_left"]]
  },
  {
    "id": "slider_sh_servo_left",
    "type": "ui_slider",
    "z": "sarcus_tab",
    "name": "Shoulder L — Servo",
    "group": "ui_group_shoulder",
    "order": 2,
    "width": "6",
    "height": "1",
    "label": "L-Shoulder Servo (°)",
    "tooltip": "0 to 270",
    "min": 0,
    "max": 270,
    "step": 1,
    "outs": "all",
    "topic": "sh_servo_left",
    "x": 600,
    "y": 140,
    "wires": [["func_shoulder_left"]]
  },
  {
    "id": "func_shoulder_left",
    "type": "function",
    "z": "sarcus_tab",
    "name": "Build Shoulder L cmd",
    "func": "var dc    = flow.get('sh_dc_left')    || 0;\nvar servo = flow.get('sh_servo_left') || 0;\n\nif (msg.topic === 'sh_dc_left')    flow.set('sh_dc_left',    msg.payload);\nif (msg.topic === 'sh_servo_left') flow.set('sh_servo_left', msg.payload);\n\ndc    = flow.get('sh_dc_left')    || dc;\nservo = flow.get('sh_servo_left') || servo;\n\nmsg.topic   = 'sarcus/robot/joints/shoulder';\nmsg.payload = JSON.stringify({dc_angle: dc, servo: servo, side: 0});\nreturn msg;",
    "outputs": 1,
    "x": 820,
    "y": 120,
    "wires": [["mqtt_out_cmd", "debug_shoulder"]]
  },
  {
    "id": "slider_sh_dc_right",
    "type": "ui_slider",
    "z": "sarcus_tab",
    "name": "Shoulder R — DC",
    "group": "ui_group_shoulder",
    "order": 3,
    "width": "6",
    "height": "1",
    "label": "R-Shoulder DC (°)",
    "min": -180,
    "max": 180,
    "step": 1,
    "outs": "all",
    "topic": "sh_dc_right",
    "x": 600,
    "y": 200,
    "wires": [["func_shoulder_right"]]
  },
  {
    "id": "slider_sh_servo_right",
    "type": "ui_slider",
    "z": "sarcus_tab",
    "name": "Shoulder R — Servo",
    "group": "ui_group_shoulder",
    "order": 4,
    "width": "6",
    "height": "1",
    "label": "R-Shoulder Servo (°)",
    "min": 0,
    "max": 270,
    "step": 1,
    "outs": "all",
    "topic": "sh_servo_right",
    "x": 600,
    "y": 240,
    "wires": [["func_shoulder_right"]]
  },
  {
    "id": "func_shoulder_right",
    "type": "function",
    "z": "sarcus_tab",
    "name": "Build Shoulder R cmd",
    "func": "if (msg.topic === 'sh_dc_right')    flow.set('sh_dc_right',    msg.payload);\nif (msg.topic === 'sh_servo_right') flow.set('sh_servo_right', msg.payload);\n\nvar dc    = flow.get('sh_dc_right')    || 0;\nvar servo = flow.get('sh_servo_right') || 0;\n\nmsg.topic   = 'sarcus/robot/joints/shoulder';\nmsg.payload = JSON.stringify({dc_angle: dc, servo: servo, side: 1});\nreturn msg;",
    "outputs": 1,
    "x": 820,
    "y": 220,
    "wires": [["mqtt_out_cmd"]]
  },

