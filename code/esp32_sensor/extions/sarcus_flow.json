  {
    "id": "mqtt_in_ultrasonic",
    "type": "mqtt in",
    "z": "sarcus_tab",
    "name": "Ultrasonic",
    "topic": "sarcus/sensors/ultrasonic",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker",
    "x": 160,
    "y": 840,
    "wires": [["func_ultrasonic_display"]]
  },
  {
    "id": "func_ultrasonic_display",
    "type": "function",
    "z": "sarcus_tab",
    "name": "Parse Ultrasonic",
    "func": "var d = msg.payload;\nif (!d) return null;\nvar warn = 30;\nreturn [\n  [{payload: d.front !== undefined ? d.front.toFixed(1) : '--'}],\n  [{payload: d.back  !== undefined ? d.back.toFixed(1)  : '--'}],\n  [{payload: d.left  !== undefined ? d.left.toFixed(1)  : '--'}],\n  [{payload: d.right !== undefined ? d.right.toFixed(1) : '--'}]\n];",
    "outputs": 4,
    "x": 380,
    "y": 840,
    "wires": [["gauge_us_front"], ["gauge_us_back"], ["gauge_us_left"], ["gauge_us_right"]]
  },
  {
    "id": "gauge_us_front",
    "type": "ui_gauge",
    "z": "sarcus_tab",
    "name": "US Front",
    "group": "ui_group_sensors",
    "order": 5,
    "width": "3",
    "height": "3",
    "gtype": "gage",
    "title": "Front (cm)",
    "label": "cm",
    "format": "{{value}}",
    "min": 0,
    "max": 400,
    "segments": 3,
