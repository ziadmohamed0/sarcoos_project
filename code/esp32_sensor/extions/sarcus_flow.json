  {
    "id": "comment_sensors",
    "type": "comment",
    "z": "sarcus_tab",
    "name": "═══ SENSOR DISPLAY ═══",
    "x": 160,
    "y": 680
  },

  {
    "id": "mqtt_in_imu",
    "type": "mqtt in",
    "z": "sarcus_tab",
    "name": "IMU Data",
    "topic": "sarcus/sensors/imu",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker",
    "x": 160,
    "y": 740,
    "wires": [["func_imu_display"]]
  },
  {
    "id": "func_imu_display",
    "type": "function",
    "z": "sarcus_tab",
    "name": "Parse IMU",
    "func": "var d = msg.payload;\nif (!d) return null;\nreturn [\n  [{payload: d.roll  !== undefined ? d.roll.toFixed(1)  : '--', topic:'roll'}],\n  [{payload: d.pitch !== undefined ? d.pitch.toFixed(1) : '--', topic:'pitch'}],\n  [{payload: d.yaw   !== undefined ? d.yaw.toFixed(1)   : '--', topic:'yaw'}]\n];",
    "outputs": 3,
    "x": 360,
    "y": 740,
    "wires": [["gauge_roll"], ["gauge_pitch"], ["gauge_yaw"]]
  },
  {
    "id": "gauge_roll",
    "type": "ui_gauge",
    "z": "sarcus_tab",
    "name": "Roll",
    "group": "ui_group_sensors",
    "order": 1,
    "width": "3",
    "height": "3",
    "gtype": "gage",
    "title": "Roll (°)",
    "label": "°",
    "format": "{{value}}",
    "min": -180,
    "max": 180,
    "segments": 3,
    "arc": 180,
    "colorHigh": "#F44336",
    "colorMid":  "#4CAF50",
    "colorLow":  "#F44336",
    "x": 560,
    "y": 700,
    "wires": []
  },
  {
    "id": "gauge_pitch",
    "type": "ui_gauge",
    "z": "sarcus_tab",
    "name": "Pitch",
    "group": "ui_group_sensors",
    "order": 2,
    "width": "3",
    "height": "3",
    "gtype": "gage",
    "title": "Pitch (°)",
    "label": "°",
    "format": "{{value}}",
    "min": -90,
    "max": 90,
    "segments": 3,
    "arc": 180,
