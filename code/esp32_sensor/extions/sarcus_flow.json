    "width": "12",
    "height": "8",
    "format": "<div style='font-family:monospace;font-size:11px;background:#1a1a1a;color:#0f0;padding:10px;height:180px;overflow-y:auto;white-space:pre;border-radius:6px' id='dbg'>{{msg.payload}}</div><script>var el=document.getElementById('dbg');if(el)el.scrollTop=el.scrollHeight;</script>",
    "storeOutMessages": true,
    "x": 620,
    "y": 1080,
    "wires": []
  },
